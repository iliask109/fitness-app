{
  "name": "fitness-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:api && tsc -b && vite build",
    "preview": "vite preview",
    "build:api": "esbuild src/lib/reminders.ts --bundle --format=esm --platform=node --target=node18 --outfile=api/_lib/reminders.js --log-level=warning",
    "sql:setup": "node scripts/build-setup-sql.mjs",
    "test": "vitest run",
    "typecheck": "npm run build:api && tsc -b && tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/web-push": "3.6.4",
    "@vercel/node": "^32.0.0",
    "@vitejs/plugin-react": "4.3.2",
    "axe-core": "^4.10.2",
    "typescript": "5.6.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
